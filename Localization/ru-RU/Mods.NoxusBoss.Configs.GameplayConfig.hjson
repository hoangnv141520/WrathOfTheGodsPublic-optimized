DisplayName: Геймплей

AllowSeedOfWillAnywhere: {
	Label: Разрешить «Семя воли» вне Вечного сада
	Tooltip:
		'''
		Если включено, «Семя воли» может призвать Безымянное божество где угодно (в основном мире, в других подмирьях и т.д.), пока он ещё не жив.
		По умолчанию предмет работает только во внутреннем мире Вечного сада (Генезис), поэтому в других местах кажется «заблокированным».
		'''
}
